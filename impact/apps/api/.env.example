# ─── Impact API — Environment Variables ──────────────────────────────────────
# Copy to .env.local and fill in values.
# DO NOT commit .env.local to git.

# App
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impact
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# WorkOS (optional — for enterprise SSO)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# AWS (optional for dev — uses local paths without S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_POLICIES=impact-policies-dev
S3_BUCKET_DOCUMENTS=impact-documents-dev
S3_BUCKET_EXPORTS=impact-exports-dev

# OpenAI (required for AI features — Phase 7+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=2000
AI_CONFIDENCE_THRESHOLD=0.75

# Monitoring (optional)
SENTRY_DSN=
